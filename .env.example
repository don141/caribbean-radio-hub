# Environment variable template — copy to `.env.local` and fill in.
# `.env*` is gitignored (see .gitignore); NEVER commit real values.
#
#   cp .env.example .env.local
#
# The Firebase *web* config below is public (safe to ship to the browser) but is
# kept in env so it is not hard-coded per environment. Private credentials
# (service-account keys, google-services.json, GoogleService-Info.plist) are
# secrets and must never be committed — see README "Prod project & Auth".

# --- Firebase web (client) config: NEXT_PUBLIC_* is exposed to the browser ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Local emulator suite (see README "Run the emulator suite") ---
# Uncomment to point the app at local emulators instead of a live project:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
